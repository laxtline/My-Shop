{
  "info": {
    "name": "Ramachandra Traders API",
    "description": "Complete REST API for the Ramachandra Traders e-commerce platform (Tiles - Paints - Electrical - Home Interiors).\n\nSETUP\n1. Start the backend:  cd Website/backend && npm run dev\n2. Set the `baseUrl` collection variable (default http://localhost:5000).\n3. Sign in on the website once at http://localhost:3000 — the browser stores an httpOnly `token` cookie.\n4. For protected routes in Postman, copy that cookie value into the `token` collection variable. Requests send it as an `Authorization: Bearer` header, which the API also accepts.\n\nRESPONSE ENVELOPE\nEvery response uses one shape: { success, data?, message? }.\n\nROLES\nPUBLIC = no auth. USER = signed in. ADMIN = the ADMIN_EMAIL account only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "productSlug", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "addressId", "value": "", "type": "string" },
    { "key": "couponId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "00 - Health",
      "item": [
        {
          "name": "GET /api/health  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] },
            "description": "Liveness probe. Returns { status: 'ok', uptime }. Used by Render/UptimeRobot to keep the free instance awake."
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST /api/auth/google  (PUBLIC)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"<Google ID token from Google Sign-In>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] },
            "description": "Verifies the Google ID token, upserts the user, and issues a JWT in an httpOnly cookie.\n\nRate limited to 20 attempts / 15 min / IP.\nRole is derived server-side from the email — never sent by the client."
          }
        },
        {
          "name": "GET /api/auth/me  (USER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "Returns the signed-in user, including saved addresses and role. Called on every page load to restore the session."
          }
        },
        {
          "name": "POST /api/auth/logout  (PUBLIC)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Clears the auth cookie."
          }
        }
      ]
    },
    {
      "name": "02 - Brand",
      "item": [
        {
          "name": "GET /api/brand  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/brand", "host": ["{{baseUrl}}"], "path": ["api", "brand"] },
            "description": "Live store branding (name, tagline, logo, support phone/email, theme colour). Clients must fetch this rather than hardcoding — the shop can be re-skinned with no code change."
          }
        },
        {
          "name": "PUT /api/brand  (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appName\": \"Ramachandra Traders\",\n  \"tagline\": \"Everything for Your Dream Home\",\n  \"themeColor\": \"#2563eb\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/brand", "host": ["{{baseUrl}}"], "path": ["api", "brand"] },
            "description": "Update store branding."
          }
        }
      ]
    },
    {
      "name": "03 - Categories",
      "item": [
        {
          "name": "GET /api/categories  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] },
            "description": "All categories, ordered by their `order` field."
          }
        },
        {
          "name": "GET /api/categories/:slug  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories/tiles", "host": ["{{baseUrl}}"], "path": ["api", "categories", "tiles"] },
            "description": "One category by slug. Try: tiles, paints, electrical, home-interiors."
          }
        },
        {
          "name": "POST /api/categories  (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plumbing\",\n  \"image\": \"https://picsum.photos/seed/cat-plumbing/600/400\",\n  \"order\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] },
            "description": "Create a category. The slug is generated from the name."
          }
        },
        {
          "name": "PUT /api/categories/:id  (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Plumbing & Sanitary\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          }
        },
        {
          "name": "DELETE /api/categories/:id  (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "categories", "{{categoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "04 - Products",
      "item": [
        {
          "name": "GET /api/products  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=tiles&minPrice=100&maxPrice=5000&minRating=4&minDiscount=10&availability=in&sort=newest&page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category", "value": "tiles", "description": "Category slug" },
                { "key": "brand", "value": "", "description": "Brand name", "disabled": true },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "5000" },
                { "key": "minRating", "value": "4", "description": "1-5" },
                { "key": "minDiscount", "value": "10", "description": "Percent off MRP" },
                { "key": "availability", "value": "in", "description": "'in' = in stock only" },
                { "key": "sort", "value": "newest", "description": "newest | price-asc | price-desc | rating | discount" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12", "description": "Max 100" }
              ]
            },
            "description": "Paginated catalogue with filters and sorting.\n\nReturns: { items, page, limit, total, totalPages }.\nAll filters are optional and combine freely."
          }
        },
        {
          "name": "GET /api/products/:slug  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productSlug}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productSlug}}"] },
            "description": "One product by slug, with category populated, image gallery, bulk-pricing tiers, GST rate and stock."
          }
        },
        {
          "name": "GET /api/products/admin/all  (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/admin/all?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "products", "admin", "all"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] },
            "description": "Admin catalogue listing, including out-of-stock and unlisted items."
          }
        },
        {
          "name": "POST /api/products  (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Glossy Vitrified Floor Tile 600x600\",\n  \"description\": \"Premium glazed vitrified tile with a high-gloss finish.\",\n  \"category\": \"{{categoryId}}\",\n  \"brand\": \"Kajaria\",\n  \"sku\": \"TIL-VIT-600\",\n  \"price\": 48,\n  \"mrp\": 65,\n  \"unit\": \"sqft\",\n  \"stock\": 500,\n  \"gstRate\": 18,\n  \"images\": [\"https://picsum.photos/seed/tile-1/700/700\"],\n  \"bulkPricing\": [\n    { \"minQty\": 100, \"pricePerUnit\": 45 },\n    { \"minQty\": 500, \"pricePerUnit\": 42 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Create a product. `category` must be a valid category ObjectId — omitting it returns 400."
          }
        },
        {
          "name": "PUT /api/products/:id  (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 46,\n  \"stock\": 620\n}" },
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        },
        {
          "name": "DELETE /api/products/:id  (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          }
        }
      ]
    },
    {
      "name": "05 - Search",
      "item": [
        {
          "name": "GET /api/search  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/search?q=tile", "host": ["{{baseUrl}}"], "path": ["api", "search"], "query": [{ "key": "q", "value": "tile" }] },
            "description": "Full-text search across product title, description and brand."
          }
        }
      ]
    },
    {
      "name": "06 - Cart",
      "item": [
        {
          "name": "GET /api/cart  (USER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] },
            "description": "Current user's cart with products populated. Returns 401 without a valid session."
          }
        },
        {
          "name": "POST /api/cart/add  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}" },
            "url": { "raw": "{{baseUrl}}/api/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "add"] },
            "description": "Add to cart. Adding an item already present increments its quantity."
          }
        },
        {
          "name": "PUT /api/cart/update  (USER)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 5\n}" },
            "url": { "raw": "{{baseUrl}}/api/cart/update", "host": ["{{baseUrl}}"], "path": ["api", "cart", "update"] },
            "description": "Set an exact quantity. Quantity 0 removes the line."
          }
        },
        {
          "name": "DELETE /api/cart/remove/:id  (USER)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/cart/remove/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "cart", "remove", "{{productId}}"] }
          }
        }
      ]
    },
    {
      "name": "07 - Wishlist",
      "item": [
        {
          "name": "GET /api/wishlist  (USER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/wishlist", "host": ["{{baseUrl}}"], "path": ["api", "wishlist"] }
          }
        },
        {
          "name": "POST /api/wishlist/add  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/wishlist/add", "host": ["{{baseUrl}}"], "path": ["api", "wishlist", "add"] }
          }
        },
        {
          "name": "DELETE /api/wishlist/remove/:id  (USER)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/wishlist/remove/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "wishlist", "remove", "{{productId}}"] }
          }
        }
      ]
    },
    {
      "name": "08 - Orders",
      "item": [
        {
          "name": "POST /api/orders  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddress\": {\n    \"fullName\": \"Suryakant Pradhan\",\n    \"phone\": \"9876543210\",\n    \"line1\": \"Plot 21, MG Road\",\n    \"line2\": \"Near Bus Stand\",\n    \"city\": \"Bhubaneswar\",\n    \"state\": \"Odisha\",\n    \"pincode\": \"751001\"\n  },\n  \"paymentMethod\": \"COD\",\n  \"notes\": \"Please call before delivery.\",\n  \"couponCode\": \"\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] },
            "description": "Place an order from the current cart.\n\nThe server re-validates everything: address format, live prices, bulk-pricing tiers, coupon, stock. Client-sent totals are never trusted. On success it decrements stock and empties the cart.\n\npaymentMethod: COD | RAZORPAY"
          }
        },
        {
          "name": "GET /api/orders  (USER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] },
            "description": "The signed-in user's order history, newest first."
          }
        },
        {
          "name": "GET /api/orders/:id  (USER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] },
            "description": "One order with its tracking timeline. A user can only read their own orders; an admin can read any."
          }
        },
        {
          "name": "PATCH /api/orders/:id/cancel  (USER)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "cancel"] },
            "description": "Cancel your own order. Only allowed while it is PLACED or CONFIRMED. Restores stock."
          }
        },
        {
          "name": "GET /api/orders/admin/all  (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/admin/all?status=PLACED", "host": ["{{baseUrl}}"], "path": ["api", "orders", "admin", "all"], "query": [{ "key": "status", "value": "PLACED", "description": "Optional: PLACED | CONFIRMED | SHIPPED | DELIVERED | CANCELLED" }] },
            "description": "All orders across all users, optionally filtered by status."
          }
        },
        {
          "name": "GET /api/orders/admin/stats  (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "orders", "admin", "stats"] },
            "description": "Headline totals: { totalOrders, revenue, statusCounts }."
          }
        },
        {
          "name": "GET /api/orders/admin/analytics  (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/admin/analytics", "host": ["{{baseUrl}}"], "path": ["api", "orders", "admin", "analytics"] },
            "description": "Sales analytics: { revenueByDay (last 14 days), topProducts }. Computed with a MongoDB aggregation pipeline."
          }
        },
        {
          "name": "PATCH /api/orders/:id/status  (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}", "status"] },
            "description": "Advance an order through the status state machine.\n\nAllowed transitions:\n  PLACED    -> CONFIRMED | CANCELLED\n  CONFIRMED -> SHIPPED   | CANCELLED\n  SHIPPED   -> DELIVERED\n  DELIVERED -> (terminal)\n  CANCELLED -> (terminal)\n\nIllegal jumps (e.g. PLACED -> DELIVERED) are rejected with 400. Marking a COD order DELIVERED also marks it PAID."
          }
        }
      ]
    },
    {
      "name": "09 - Payments (Razorpay)",
      "item": [
        {
          "name": "GET /api/payments/config  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/config", "host": ["{{baseUrl}}"], "path": ["api", "payments", "config"] },
            "description": "Returns { razorpayEnabled, razorpayKeyId }. The checkout page shows 'Pay Online' only when enabled. The key SECRET is never sent to the client."
          }
        },
        {
          "name": "POST /api/payments/razorpay/order  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/payments/razorpay/order", "host": ["{{baseUrl}}"], "path": ["api", "payments", "razorpay", "order"] },
            "description": "Creates a Razorpay order for an existing local order and returns the details the checkout widget needs."
          }
        },
        {
          "name": "POST /api/payments/razorpay/verify  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"razorpay_order_id\": \"order_xxx\",\n  \"razorpay_payment_id\": \"pay_xxx\",\n  \"razorpay_signature\": \"signature_xxx\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/payments/razorpay/verify", "host": ["{{baseUrl}}"], "path": ["api", "payments", "razorpay", "verify"] },
            "description": "Verifies the HMAC-SHA256 signature server-side before marking the order PAID. A client claiming success is never trusted."
          }
        }
      ]
    },
    {
      "name": "10 - Reviews",
      "item": [
        {
          "name": "GET /api/reviews/product/:productId  (PUBLIC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/reviews/product/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "product", "{{productId}}"] }
          }
        },
        {
          "name": "POST /api/reviews  (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product\": \"{{productId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent quality, delivered on time.\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"] },
            "description": "Post a review. `rating` must be 1-5 (a 9 returns 400). One review per user per product; the product's average rating and review count are recomputed on save."
          }
        },
        {
          "name": "DELETE /api/reviews/:id  (USER/ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/reviews/{{reviewId}}", "host": ["{{baseUrl}}"], "path": ["api", "reviews", "{{reviewId}}"] },
            "description": "Delete your own review, or any review as admin."
          }
        }
      ]
    },
