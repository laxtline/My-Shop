{
  "name": "ramachandra-traders-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + MongoDB backend for Ramachandra Traders.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx src/seed/smokeTest.ts",
    "seed:brand": "tsx src/seed/brandSeed.ts",
    "seed:products": "tsx src/seed/productSeed.ts",
    "seed": "tsx src/seed/brandSeed.ts && tsx src/seed/productSeed.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.12",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "^5.7.3"
  }
}
