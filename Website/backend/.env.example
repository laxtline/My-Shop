# ---- Server ----
NODE_ENV=development
PORT=5000
# Origin of the Next.js frontend (used for CORS + cookie). No trailing slash.
# Accepts a comma-separated allow-list, which you need on deploy so the
# production domain and Vercel preview domains are both permitted, e.g.
#   CLIENT_ORIGIN=https://my-shop.vercel.app,https://my-shop-git-dev.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# Local MongoDB:   mongodb://127.0.0.1:27017/ramachandra
# MongoDB Atlas:   mongodb+srv://<user>:<pass>@<cluster>/ramachandra
MONGODB_URI=mongodb://127.0.0.1:27017/ramachandra

# ---- Auth ----
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth Client ID (Web application) from https://console.cloud.google.com
# Authorized JavaScript origin must include http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: iOS/Android OAuth client ids used by the mobile app. ID tokens issued
# to a native client have a different audience than the web client, so list them
# here (comma separated) or mobile Google sign-in will be rejected.
GOOGLE_MOBILE_CLIENT_IDS=

# ---- Online payments (Razorpay) — OPTIONAL ----
# Leave both blank to keep only Cash-on-Delivery. When both are set, the
# "Pay Online" option appears at checkout. Get keys from https://dashboard.razorpay.com
# (Settings -> API Keys). Use Test Mode keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for verifying Razorpay webhook signatures.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Public HTTPS origin of this API, e.g. https://api.your-shop.in
# Used for uploaded image URLs and webhook documentation.
PUBLIC_API_URL=
# Public http(s) page opened after a hosted (mobile) Razorpay payment link
# completes, e.g. https://your-shop.in/orders. Razorpay does not accept custom
# app schemes here. Leave blank to keep the browser on Razorpay's receipt page.
MOBILE_PAYMENT_RETURN_URL=

# ---- Shipping / couriers — OPTIONAL ----
# Without credentials the shop still quotes zone-based delivery estimates;
# creating a live shipment (AWB, label, pickup) needs one of the integrations.
# Configure ONE of the following:
#
# 1) Shiprocket aggregator (recommended): one login reaches Ekart, Delhivery,
#    Blue Dart, DTDC, XpressBees, Shadowfax and more.
#    https://app.shiprocket.in/api/user/login -> email + password.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in
# Pickup location nickname created in Shiprocket -> Settings -> Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
# Shared secret for Shiprocket webhooks. In Shiprocket -> Settings -> Webhooks
# set the URL to https://api.your-shop.in/api/shipping/webhook/shiprocket and
# add this value as a custom header x-webhook-token.
SHIPROCKET_WEBHOOK_TOKEN=
#
# 2) Direct Delhivery contract (alternative to the aggregator).
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_PICKUP_LOCATION=Primary Warehouse
DELHIVERY_CLIENT_NAME=
DELHIVERY_WEBHOOK_TOKEN=
#
# Warehouse defaults (also editable in Admin -> Shipping -> Settings).
STORE_PINCODE=751001
STORE_CITY=Bhubaneswar
STORE_STATE=Odisha

# ---- Email notifications (Resend) — OPTIONAL ----
# Leave blank to disable emails (order events are just logged to the console).
# When both are set, order-placed / status-change emails are sent via Resend.
# Get an API key at https://resend.com. EMAIL_FROM must be a verified sender,
# e.g. "Ramachandra Traders <orders@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# ---- Refunds — OPTIONAL but recommended ----
# 32-byte hex key used to encrypt UPI/bank refund account details at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFUND_ENCRYPTION_KEY=

# ---- Push notifications — OPTIONAL ----
# Set to true after configuring EAS + uploading an FCM/APNs credential.
EXPO_PUSH_ENABLED=false
