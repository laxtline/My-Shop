# ---- Server ----
NODE_ENV=development
PORT=5000
# Origin of the Next.js frontend (used for CORS + cookie). No trailing slash.
# Accepts a comma-separated allow-list, which you need on deploy so the
# production domain and Vercel preview domains are both permitted, e.g.
#   CLIENT_ORIGIN=https://my-shop.vercel.app,https://my-shop-git-dev.vercel.app
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# Local MongoDB:   mongodb://127.0.0.1:27017/ramachandra
# MongoDB Atlas:   mongodb+srv://<user>:<pass>@<cluster>/ramachandra
MONGODB_URI=mongodb://127.0.0.1:27017/ramachandra

# ---- Auth ----
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth Client ID (Web application) from https://console.cloud.google.com
# Authorized JavaScript origin must include http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ---- Online payments (Razorpay) — OPTIONAL ----
# Leave both blank to keep only Cash-on-Delivery. When both are set, the
# "Pay Online" option appears at checkout. Get keys from https://dashboard.razorpay.com
# (Settings -> API Keys). Use Test Mode keys during development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email notifications (Resend) — OPTIONAL ----
# Leave blank to disable emails (order events are just logged to the console).
# When both are set, order-placed / status-change emails are sent via Resend.
# Get an API key at https://resend.com. EMAIL_FROM must be a verified sender,
# e.g. "Ramachandra Traders <orders@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=
