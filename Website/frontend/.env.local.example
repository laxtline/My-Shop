# Base URL of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google OAuth Client ID (Web application) — same value as the backend's GOOGLE_CLIENT_ID.
# Authorized JavaScript origin must include http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Public URL of THIS website (no trailing slash). Used for SEO: sitemap,
# robots, canonical URLs and Open Graph tags. In production set your real domain,
# e.g. https://ramachandratraders.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
