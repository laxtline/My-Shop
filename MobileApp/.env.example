# API origin. On a physical phone use your computer's LAN IP, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Google OAuth. The native ids must also be listed in the backend's
# GOOGLE_MOBILE_CLIENT_IDS, otherwise ID-token verification fails.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Optional exact redirect URI registered in Google Cloud.
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=

# From `npx eas init`; required for Expo push tokens in store builds.
EAS_PROJECT_ID=
