{
  "expo": {
    "name": "Ramachandra Traders",
    "slug": "ramachandra-traders",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ramachandra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "android": {
      "package": "com.ramachandratraders.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ramachandratraders.app",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://localhost:5000",
      "storefrontUrl": "http://localhost:3000"
    }
  }
}
